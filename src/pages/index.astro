---
import Layout from '../layouts/Layout.astro';
import data from '../data/links.json';

interface Link {
	title: string;
	url: string;
	newTab?: boolean;
}

const { profile } = data;
const links: Link[] = data.links.filter((link) => link.listed);
---

<Layout title={profile.name} description={profile.bio}>
	<header>
		<h1>{profile.name}</h1>
		<p>{profile.bio}</p>
	</header>

	<ul>
		{
			links.map((link) => (
				<li>
					<a
						href={link.url}
						target={link.newTab ? '_blank' : undefined}
						rel={link.newTab ? 'noopener' : undefined}
					>
						{link.title}
						{link.newTab && <span class="visually-hidden"> (opens in a new tab)</span>}
					</a>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	header {
		text-align: center;
		margin-bottom: 2rem;
	}

	h1 {
		margin: 0;
		font-size: 1.75rem;
	}

	header p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	a {
		display: block;
		padding: 0.9rem 1.25rem;
		text-align: center;
		font-weight: 500;
		color: inherit;
		text-decoration: none;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		transition:
			border-color 0.15s,
			transform 0.15s;
	}

	a:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* Read by screen readers, not shown on screen. */
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
