---
import Layout from '../layouts/Layout.astro';
import data from '../data/links.json';

interface Link {
	title: string;
	url: string;
	newTab?: boolean;
}

const { profile } = data;
const links: Link[] = data.links.filter((link) => link.listed);
---

<Layout title={profile.name} description={profile.bio}>
	<header>
		<h1>{profile.name}</h1>
		<p>{profile.bio}</p>
	</header>

	<ul>
		{
			links.map((link) => (
				<li>
					<a
						href={link.url}
						target={link.newTab ? '_blank' : undefined}
						rel={link.newTab ? 'noopener' : undefined}
					>
						{link.title}
						{link.newTab && (
							<>
								<span class="visually-hidden"> (opens in a new tab)</span>
								<svg
									class="new-tab-icon"
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M15 3h6v6" />
									<path d="M10 14 21 3" />
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
								</svg>
							</>
						)}
					</a>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	header {
		text-align: center;
		margin-bottom: 2rem;
	}

	h1 {
		margin: 0;
		font-size: 1.75rem;
		letter-spacing: -0.02em;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.25);
	}

	header p {
		margin: 0.5rem 0 0;
		color: var(--muted);
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}

	/* Frosted glass card: a light dark tint over a strong blur, with a thin
	   light border and a soft shadow. */
	a {
		display: block;
		padding: 1rem 1.5rem;
		text-align: center;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
		border-radius: 1rem;
		border: 1px solid var(--glass-border);
		background-color: var(--glass-tint);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		/* The focus glow is its own shadow layer so it can fade in. --ring
		   always holds the same shadows (one inset, three outer) as the
		   focused state, so the transition can interpolate. */
		--ring:
			inset 0 0 0 transparent,
			0 0 0 transparent,
			0 0 0 transparent,
			0 0 0 transparent;
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), var(--ring), var(--glass-shadow);
		transition:
			transform 0.2s ease,
			background-color 0.2s,
			border-color 0.2s,
			box-shadow 0.2s;
	}

	a:hover {
		background-color: var(--glass-tint-hover);
		border-color: var(--glass-border-hover);
		transform: translateY(-2px);
	}

	a:active {
		transform: translateY(0);
	}

	/* Magenta neon tube: a hot-pink core line, a faint glow inside the card
	   and three outer glows that widen and fade like light off a tube. */
	a:focus-visible {
		outline: 2px solid color-mix(in oklch, var(--accent) 55%, white);
		outline-offset: 2px;
		--ring:
			inset 0 0 16px color-mix(in oklch, var(--accent) 45%, transparent),
			0 0 8px 3px var(--accent),
			0 0 24px 6px color-mix(in oklch, var(--accent) 70%, transparent),
			0 0 52px 14px color-mix(in oklch, var(--accent) 40%, transparent);
	}

	.new-tab-icon {
		width: 0.85em;
		height: 0.85em;
		margin-left: 0.4em;
		vertical-align: -0.05em;
		color: var(--muted);
	}

	@media (prefers-reduced-motion: reduce) {
		a,
		a:hover,
		a:active {
			transition: none;
			transform: none;
		}
	}

	/* People who ask for less transparency get solid, readable cards. */
	@media (prefers-reduced-transparency: reduce) {
		a {
			background-color: #1e2a36;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	@media (prefers-contrast: more) {
		a {
			border-color: var(--fg);
		}
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
